{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobkit-pro",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
